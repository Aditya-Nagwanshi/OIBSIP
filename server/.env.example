# Core
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/slice-theory
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=Demo_SliceTheory@pizza

# Email (leave SMTP_HOST blank for demo outbox mode)
EMAIL_FROM=Slice Theory <hello@slicetheory.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Inventory alerts
LOW_STOCK_CRON=*/5 * * * *
LOW_STOCK_COOLDOWN_HOURS=6

# Payments: mock | razorpay
# The UI always shows a "Razorpay test mode" simulation in mock mode.
# For the real Razorpay test checkout, set PAYMENTS_MODE=razorpay and paste
# your own test keys from dashboard.razorpay.com (Test mode -> API keys).
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=INR
